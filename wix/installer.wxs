<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer definition (WiX v4+ schema).

  Build (after tron-vanity-desktop.exe, config.xml and icon.ico are placed in dist/):
    wix build wix/installer.wxs -arch x64 -d "DistDir=<absolute path to dist>" -o dist/tron-vanity-windows-x64.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="TRON Vanity Generator"
      Manufacturer="TRON Vanity"
      Version="0.1.0"
      UpgradeCode="7c5f2b91-4d3a-4e6b-9f1c-0a8e6d24b7c5"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of TRON Vanity Generator is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(DistDir)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TRON Vanity" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="TRON Vanity" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="TRON Vanity Generator" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component Id="DesktopExecutable" Guid="3a7bd2f4-6c1e-4a5b-8d92-1f4c7b0e6a21">
        <File Id="DesktopExe" Source="$(DistDir)\tron-vanity-desktop.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="AppMenuFolder"
                    Name="TRON Vanity Generator" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder"
                    Name="TRON Vanity Generator" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        </File>
      </Component>
      <Component Id="DefaultConfig" Guid="b6e0c913-7d24-4f38-9a15-2c8e5f7d1b64">
        <File Id="ConfigXml" Source="$(DistDir)\config.xml" KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
