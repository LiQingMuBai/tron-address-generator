<?xml version="1.0" encoding="UTF-8"?>
<!-- TRON address generator global configuration -->
<AddressGeneratorConfig>

    <!-- Base chain configuration -->
    <ChainConfig>
        <ChainType>TRON</ChainType>
        <AddressPrefix>T</AddressPrefix> <!-- TRON addresses always start with T -->
        <AddressLength>34</AddressLength> <!-- Standard TRON address length -->
        <PrivateKeyFormat>Hex</PrivateKeyFormat>
    </ChainConfig>

    <!-- Task execution configuration -->
    <TaskConfig>
        <TargetCount>1</TargetCount> <!-- Total number of matching addresses to generate -->
        <ThreadCount>0</ThreadCount> <!-- Concurrent threads; 0 = auto-detect CPU cores -->
        <ExportFormat>CSV</ExportFormat> <!-- Export format: CSV, TXT, JSON -->
    </TaskConfig>

    <!-- Composite suffix conditions (multiple conditions can be combined) -->
    <CompositeConditions>
        <!-- Logic operator: AND (match all) or OR (match any) -->
        <LogicOperator>AND</LogicOperator>

        <!-- Condition 1: repeating characters (e.g. suffix contains 888) -->
        <Condition>
            <Type>Repeating</Type>
            <Param>
                <Char>8</Char>
                <MinCount>3</MinCount>
                <Position>Last</Position> <!-- Position: Last (at the end), Anywhere (any position) -->
            </Param>
        </Condition>

        <!-- Condition 2: fixed character match (e.g. 5th character from the end is A) -->
        <Condition>
            <Type>FixedChar</Type>
            <Param>
                <Char>A</Char>
                <IndexFromEnd>5</IndexFromEnd> <!-- 1-based index counted from the end -->
            </Param>
        </Condition>

        <!-- Condition 3: regular expression match (advanced custom) -->
        <Condition>
            <Type>Regex</Type>
            <Param>
                <Pattern>[a-zA-Z0-9]{4}$</Pattern> <!-- Example: last 4 characters must be letters or digits -->
            </Param>
        </Condition>
    </CompositeConditions>

</AddressGeneratorConfig>
