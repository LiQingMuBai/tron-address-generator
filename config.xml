<?xml version="1.0" encoding="UTF-8"?>
<!-- TRON address generator global configuration -->
<AddressGeneratorConfig>

    <!-- Base chain configuration -->
    <ChainConfig>
        <ChainType>TRON</ChainType>
        <AddressPrefix>T</AddressPrefix> <!-- TRON addresses always start with T -->
        <AddressLength>34</AddressLength> <!-- Standard TRON address length -->
        <PrivateKeyFormat>Hex</PrivateKeyFormat>
    </ChainConfig>

    <!-- Task execution configuration -->
    <TaskConfig>
        <TargetCount>1</TargetCount> <!-- Total number of matching addresses to generate -->
        <ThreadCount>0</ThreadCount> <!-- Concurrent threads; 0 = auto-detect CPU cores -->
        <ExportFormat>CSV</ExportFormat> <!-- Export format: CSV, TXT, JSON -->
    </TaskConfig>

    <!--
      Composite matching conditions (multiple conditions can be combined).
      Leave this section empty to generate random addresses instead of matching
      a suffix. Commented-out examples of each condition type are shown below.
    -->
    <CompositeConditions>
        <!-- Logic operator: AND (match all) or OR (match any) -->
        <LogicOperator>AND</LogicOperator>

        <!--
        Condition: repeating characters (e.g. the address ends with 888)
        <Condition>
            <Type>Repeating</Type>
            <Param>
                <Char>8</Char>
                <MinCount>3</MinCount>
                <Position>Last</Position>
            </Param>
        </Condition>
        -->

        <!--
        Condition: fixed character match (e.g. 5th character from the end is A)
        <Condition>
            <Type>FixedChar</Type>
            <Param>
                <Char>A</Char>
                <IndexFromEnd>5</IndexFromEnd>
            </Param>
        </Condition>
        -->

        <!--
        Condition: regular expression match (advanced custom)
        <Condition>
            <Type>Regex</Type>
            <Param>
                <Pattern>[a-zA-Z0-9]{4}$</Pattern>
            </Param>
        </Condition>
        -->
    </CompositeConditions>

</AddressGeneratorConfig>
